# ==========================================
# 1. مشخصات اتصال کاربری تلگرام (برای کراولر Telethon)
# ==========================================
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_telegram_api_hash_here
TELEGRAM_PHONE=+989123456789
TARGET_CHAT=@my_motor_group

# ==========================================
# 2. ربات تلگرام (aiogram 3)
# ==========================================
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
# آیدی عددی ادمین‌ها با کاما جدا شود (برای دسترسی به تنظیمات /set_model و ...)
ADMIN_IDS=12345678,87654321

# آیدی کانال یا گروه ثبت گزارش کامل خطاها (توسط دستور /set_error_channel هم قابل تنظیم است)
ERROR_CHANNEL_ID=-1001234567890

# تعداد تردهای بازیابی‌شده از Qdrant جهت ارسال به مدل (پیش‌فرض ۸ منبع)
RAG_TOP_K=8


# ==========================================
# 3. تنظیمات مدل هوش مصنوعی (سازگار با همه ارائه‌دهندگان)
# ==========================================
# مدل پیش‌فرض (توسط دستور /set_model ادمین در بات هم قابل تغییر است)
LLM_MODEL=gemini-2.0-flash

# آدرس پایه API (توسط دستور /set_base_url ادمین در بات هم قابل تغییر است)
# نمونه‌ها:
# گوگل: https://generativelanguage.googleapis.com/v1beta/openai/
# اوپن‌ای‌آی: https://api.openai.com/v1
# اوپن‌روتر: https://openrouter.ai/api/v1
# دیپ‌سیک: https://api.deepseek.com/v1
# لوکال/اولاما: http://localhost:11434/v1
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# کلید API (توسط دستور /set_api_key ادمین هم قابل تنظیم است)
LLM_API_KEY=your_llm_api_key_here

# توکن رایگان Hugging Face (برای برداری کردن سوالات در سرور با مدل BGE-M3 بدون مصرف رم)
HF_TOKEN=hf_your_free_token_here

# ==========================================
# 4. پایگاه داده برداری Qdrant (لوکال یا ابری)
# ==========================================
# برای استفاده ابری (Qdrant Cloud) یا سرور مجزا، دو متغیر زیر را فعال کنید (مصرف رم ربات به زیر ۸۰ مگابایت می‌رسد):
# QDRANT_URL=https://xxxxxx-xxxx.cloud.qdrant.io:6333
# QDRANT_API_KEY=your_qdrant_api_key_here

# در صورت خالی بودن QDRANT_URL، به صورت خودکار از مسیر محلی زیر استفاده می‌شود:
QDRANT_PATH=data/qdrant_db
QDRANT_COLLECTION=motor_threads

# ==========================================
# 5. مسیرهای پایگاه داده پیام‌ها و فایل‌ها
# ==========================================
DB_PATH=data/messages.db
SESSION_DIR=sessions
SESSION_NAME=telegram_crawler

